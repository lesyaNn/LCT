# --- Keycloak dev bootstrap (DEMO ONLY, never production) ---
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me

# --- Auth ---
NEXT_PUBLIC_AUTH_MODE=keycloak
APP_ENV=dev
KEYCLOAK_REALM=rtk
KEYCLOAK_AUDIENCE=rtk-api
KEYCLOAK_CLIENT_ID=rtk-frontend
FRONTEND_ORIGIN=http://localhost:3000
# Public Keycloak URL as seen by BROWSERS (override per stand, e.g.
# http://192.168.1.10:8081). Backend issuer + SPA config derive from it —
# no rebuild needed. After changing, run:
#   FRONTEND_ORIGIN=<same-host-origin> python3 keycloak/render_realm.py
KEYCLOAK_EXTERNAL_URL=http://localhost:8081
# Same-origin /api/ proxy is the default (empty = no CORS, no rebuild).
# Set to http://<host>:8000 only to bypass the proxy (direct mode).
FRONTEND_API_URL=

# --- Frontend data source (Next.js public build-time configuration) ---
# `real` is the safe default. Use `mock` together with mock auth for a local
# frontend-only demo: NEXT_PUBLIC_AUTH_MODE=mock NEXT_PUBLIC_DATA_SOURCE=mock npm run dev
NEXT_PUBLIC_DATA_SOURCE=real
NEXT_PUBLIC_MOCK_API_DELAY_MS=350
# A production build ignores mock mode unless this explicit demo-only opt-in
# is true. Keep false for regular production builds.
NEXT_PUBLIC_ALLOW_MOCK_API_IN_PRODUCTION=false
NEXT_PUBLIC_MOCK_ROLE=manager

# Fail-closed: compose must run with false (real Keycloak validation).
AUTH_DEV_BYPASS=false

# --- API security / storage (placeholders only) ---
# Comma-separated explicit origins; never use * with credentials in production.
CORS_ORIGINS=http://localhost:3000
STORAGE_BACKEND=local
STORAGE_ROOT=/app/storage
REPORTS_ROOT=/app/reports
MAX_UPLOAD_MB=50
UPLOAD_ALLOWED_EXTENSIONS=
# Required when STORAGE_BACKEND=s3|minio; no code fallback is provided.
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=rtk-files

# --- PostgreSQL (P1) ---
POSTGRES_USER=rtk
POSTGRES_PASSWORD=change-me
POSTGRES_DB=rtk
# PG is internal-only (expose, no host ports). Reach it via:
#   docker compose exec postgres psql -U rtk -d rtk
# Backend in compose overrides this via service env; set it locally to talk
# to your own instance:
# DATABASE_URL=postgresql+psycopg://rtk:change-me@localhost:5432/rtk
# M5: DB pool/timeouts (PostgreSQL only, backend/app/db/session.py):
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=10
# DB_POOL_TIMEOUT=30
# DB_STATEMENT_TIMEOUT_MS=30000

# --- Keycloak database (separate `keycloak` DB on the same postgres server) ---
# Keycloak internal tables live here (managed by Keycloak itself, NOT Alembic).
# The application database above (rtk) is untouched by Keycloak.
KEYCLOAK_DB=keycloak
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=change-me
